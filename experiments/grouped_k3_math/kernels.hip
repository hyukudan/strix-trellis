    for(int j=0;j<4;++j) transformed[size_t(row)*input_size+begin+lane+32*j]=_Float16(values[j]);

}

__global__ __launch_bounds__(128) void grouped_baseline_core(NativeBatch b) {
const int batch_group=blockIdx.z;
